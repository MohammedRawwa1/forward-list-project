AUTO_CREATE_INDEXES=true
BOT_OWNER_ID=123456789
BOT_TOKEN=123456:ABCDEF123456
GOFILE_TOKEN=your-gofile-token
GUI_SESSION_TTL=3600
LOGS_CHANNEL=-1006666666666
MONGODB_NAME=list_forwarder
MONGODB_URL=mongodb://localhost:27017/list_forwarder
PORT=8080
Telegram_API_HASH=your-telegram-api-hash
Telegram_APP_ID=123456

# Webhook URL — if set, the bot will auto-register this URL with Telegram on every startup.
# If not set but RENDER_EXTERNAL_URL is available, the URL is constructed automatically.
# Leave empty to skip auto-registration.
WEBHOOK_URL=

# Optional secret token for webhook verification (X-Telegram-Bot-Api-Secret-Token header).
# If set, the /webhook fallback endpoint will require this header.
TELEGRAM_SECRET_TOKEN=
