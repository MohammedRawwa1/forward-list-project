# =============================================================================
# Forward List Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables have safe defaults where noted.  You only NEED to set:
#   BOT_TOKEN, MONGODB_URL, MONGODB_NAME
# Everything else is optional.

# ── Telegram ──────────────────────────────────────────────────────────────────

# Your bot token from @BotFather (REQUIRED — no default)
BOT_TOKEN=

# Telegram App ID & API hash (used if you need user-client operations)
TELEGRAM_APP_ID=
TELEGRAM_API_HASH=

# Secret token for Telegram webhook (optional — enables HMAC verification)
TELEGRAM_SECRET_TOKEN=

# Chat/Channel ID for logs (optional — bot will send some logs here)
LOGS_CHANNEL=

# ── MongoDB ──────────────────────────────────────────────────────────────────

# MongoDB connection URI (REQUIRED — no default)
MONGODB_URL=

# MongoDB database name (REQUIRED — no default)
MONGODB_NAME=

# Set to "1", "true", "yes", or "on" to auto-create indexes on startup
# Default: 0 (off)
AUTO_CREATE_INDEXES=0

# ── Redis (optional — enables rate-limit sharing & durable callback refs) ────

# Redis connection URL.  When set:
#   - Token buckets use atomic Lua scripts (multi-process safe)
#   - Callback refs are persisted to Redis (survive restarts)
#   - Retry scheduling uses Redis sorted sets
# When unset, all features fall back to in-process memory.
REDIS_URL=

# ── Webhook / Server ─────────────────────────────────────────────────────────

# For production behind a reverse proxy, set the public URL explicitly.
WEBHOOK_URL=

# Render.com auto-provided external URL (fallback if WEBHOOK_URL is unset).
RENDER_EXTERNAL_URL=

# Port for the webhook HTTP server (default: 10000)
PORT=10000

# Token for the /health endpoint (optional — if unset, health returns 403)
LIVENESS_TOKEN=

# ── Atlas Search (MongoDB Atlas full-text search) ────────────────────────────

# Set to "1" to enable Atlas Search fallback for category/course queries.
USE_ATLAS_SEARCH=0

# Custom Atlas Search index name (default: "default")
ATLAS_SEARCH_INDEX_NAME=default

# ── Cache Tuning ─────────────────────────────────────────────────────────────

# How long (seconds) callback refs live in Redis/Mongo before auto-delete.
# Default: 604800 (7 days)
CALLBACK_REF_TTL=604800

# Max entries in the in-memory callback payload map.
# When exceeded, the oldest 25% are evicted on next insert.
# Default: 50000
CALLBACK_REF_TTL=604800

# Max entries in the short-lived resolve cache (hot callback refs).
# Default: 2000
CALLBACK_RESOLVE_CACHE_MAX=2000

# How many callback refs to rehydrate from Mongo on startup (0 = skip).
# Default: 10000
CALLBACK_REHYDRATE_LIMIT=10000

# Page cache TTL in seconds.  Cached course-list pages expire after this.
# Default: 30
PAGE_CACHE_TTL=30

# How long (seconds) an interactive inline keyboard session stays open.
# Accepts integer seconds or suffixed values like "5m", "2h", "1d".
# Default: 300 (5 minutes)
GUI_SESSION_TTL=300

# How often (seconds) the background cache cleanup worker runs.
# Default: 300 (5 minutes)
CACHE_CLEANUP_INTERVAL=300

# ── Rate Limiting / Debounce ────────────────────────────────────────────────

# Minimum interval (seconds) between repeated inline-keyboard presses from
# the same user.  Prevents Telegram flood-limit errors.
# Default: 0.5
EDIT_DEBOUNCE=0.5

# ── Logging ──────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Log format: "text" (colored human-readable) or "json" (structured).
# Default: text
LOG_FORMAT=text

# Maximum queued log records before QueueHandler blocks the producer.
# Under sustained load this caps memory growth (~a few MB for typical lines).
# Default: 10000
LOG_QUEUE_MAXSIZE=10000

# ── Security ─────────────────────────────────────────────────────────────────

# Telegram user ID of the bot owner.  Only this user can access admin commands
# (delete-all, category design, etc.).  When unset, ALL users are denied
# (fail-closed).
BOT_OWNER_ID=

# ── Downloads / File Limits ──────────────────────────────────────────────────

# Maximum allowed download size in bytes (default: 10 GB)
MAX_DOWNLOAD_SIZE=10737418240
